  "settings": [
    {
      "_id": {
        "$numberInt": "1"
      },
      "about_meta_description": "Kitab Nagri is Pakistan's online home for Urdu novel lovers. Since 2020, we've helped thousands of readers read and download Urdu novels for free..",
      "about_meta_title": "About Us",
      "about_page_content": "<p class=\"font-claude-response-body break-words whitespace-normal\"><span style=\"letter-spacing: 0.1px;\">Kitab Nagri began with one simple frustration — Urdu novel lovers had no proper place to read online. Broken links, endless ads, and messy formatting turned reading into a chore instead of a pleasure. That gap pushed us to build something better: a dedicated, organized library made for readers who just want a smooth reading experience.</span></p>\r\n<h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">Our Library Today</h3>\r\n<p class=\"font-claude-response-body break-words whitespace-normal\">We currently host over <strong>4,000 Urdu novels</strong>, with new titles and episodes added every week. Our collection spans multiple genres — romance, suspense, spiritual fiction, family sagas, and more — all sorted for quick, easy access.</p>\r\n<h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">What You'll Find Here</h3>\r\n<ul class=\"[li_&amp;]:mb-0 [li_&amp;]:mt-1 [li_&amp;]:gap-1 [&amp;:not(:last-child)_ul]:pb-1 [&amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3\">\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\">A smooth, distraction-free Urdu reading interface</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\">Free PDF downloads — no account or sign-up required</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\">Weekly additions of new novels and ongoing series</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\">Simple browsing by author name and genre</li>\r\n</ul>\r\n<h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">The People Behind Kitab Nagri</h3>\r\n<p class=\"font-claude-response-body break-words whitespace-normal\">Our team consists of genuine Urdu literature enthusiasts — readers, editors, and organizers — who manually review every novel before it's added to the site. Nothing goes live without being checked first. We treat this as a curated library, not a random content dump.</p>\r\n<h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">What We Stand For</h3>\r\n<ul class=\"[li_&amp;]:mb-0 [li_&amp;]:mt-1 [li_&amp;]:gap-1 [&amp;:not(:last-child)_ul]:pb-1 [&amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3\">\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Always free</strong> — no subscriptions, no hidden costs</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>No barriers</strong> — read or download without creating an account</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Fresh content</strong> — new novels added weekly, without fail</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Author respect</strong> — proper credit given to original writers, and copyright concerns handled quickly</li>\r\n</ul>\r\n<h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">Reach Out to Us</h3>\r\n<p class=\"font-claude-response-body break-words whitespace-normal\">Got a book request, spotted an issue, or are you an author/publisher with a concern? <a class=\"underline underline underline-offset-2 decoration-1 decoration-current/40 hover:decoration-current focus:decoration-current\" href=\"https://kitabnagri.com.pk/contact/\">Contact us</a> — we usually reply within 48 hours.</p>\r\n<p class=\"font-claude-response-body break-words whitespace-normal\"><strong>Kitab Nagri — Read More, Own More.</strong></p>",
      "about_page_subtitle": "Kitab Nagri is Pakistan's online home for Urdu novel lovers. Since 2020, we've helped thousands of readers read and download Urdu novels for free..",
      "about_page_title": "",
      "banner_desktop": [],
      "banner_mobile": [],
      "categories_meta_description": "",
      "categories_meta_title": "",
      "categories_page_content": "",
      "categories_page_subtitle": "",
      "categories_page_title": "",
      "community_coming_soon": false,
      "community_preview_key": "126d757fd96c220c949ad212828dd105",
      "contact_email": "logicalmoez@gmail.com",
      "contact_meta_description": "",
      "contact_meta_title": "Contact Us / Publish on Kitab Nagri",
      "contact_page_content": "<p class=\"font-claude-response-body break-words whitespace-normal\">We'd love to hear from you. Whether you have a question, a request, or just want to say hello, fill out the contact form below and our team will respond within <strong>48 hours</strong>.</p><h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">Why Readers Contact Us</h3><ul class=\"[li_&amp;]:mb-0 [li_&amp;]:mt-1 [li_&amp;]:gap-1 [&amp;:not(:last-child)_ul]:pb-1 [&amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3\">\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\">To request a novel be added to our library</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\">To report a broken link or download problem</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\">To raise a copyright or content removal concern</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\">To share feedback or suggest improvements</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\">To explore partnership or collaboration opportunities</li>\r\n</ul><h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">Are You a Writer? Publish With Us</h3><p class=\"font-claude-response-body break-words whitespace-normal\">We welcome Urdu novels from both new and established authors. If you'd like your work featured on Kitab Nagri, simply fill out the form with your name, the novel's title, and a brief summary. Our editorial team will review your submission and get back to you.</p><p class=\"font-claude-response-body break-words whitespace-normal\" data-sourcepos=\"3:1-3:66;23-88\">\r\n\r\n\r\n\r\n\r\n</p><p class=\"font-claude-response-body break-words whitespace-normal\"><strong>Kitab Nagri — Read More, Own More.</strong></p>",
      "contact_page_subtitle": "Have a question, request, or concern? We'd love to hear from you.",
      "contact_page_title": "Contact Us / Publish on Kitab Nagri",
      "contact_phone": "03198276205",
      "contact_whatsapp": "03198276205",
      "facebook_url": "",
      "footer_col1": "<h5><i class=\"fa-solid fa-file-lines\"></i> Portal</h5><p>Your premium platform for interesting articles, stories, and news. Stay tuned for exciting content updates!</p>",
      "footer_col2": "<h5 class=\"text-center\">Follow Us</h5><div class=\"social-links text-center\"><a href=\"#\"><i class=\"fa-brands fa-facebook-f\"></i></a><a href=\"#\"><i class=\"fa-brands fa-twitter\"></i></a><a href=\"#\"><i class=\"fa-brands fa-instagram\"></i></a><a href=\"#\"><i class=\"fa-brands fa-linkedin-in\"></i></a></div>",
      "footer_col3": "<h5 class=\"text-end\">Quick Links</h5><ul class=\"list-unstyled text-end mb-0\"><li><a href=\"./\" class=\"text-white text-decoration-none\">Home</a></li><li><a href=\"about/\" class=\"text-white text-decoration-none\">About Us</a></li><li><a href=\"contact/\" class=\"text-white text-decoration-none\">Contact Us</a></li></ul>",
      "google_analytics": "<!-- Google tag (gtag.js) -->\r\n<script async src=\"https://www.googletagmanager.com/gtag/js?id=G-M9BPNYC535\"></script>\r\n<script>\r\n  window.dataLayer = window.dataLayer || [];\r\n  function gtag(){dataLayer.push(arguments);}\r\n  gtag('js', new Date());\r\n\r\n  gtag('config', 'G-M9BPNYC535');\r\n</script>",
      "homepage_content": "<h1>Kitab Nagri Official</h1><p class=\"font-claude-response-body break-words whitespace-normal\">Since 2020, Kitab Nagri has been helping Urdu readers enjoy novels online and download PDFs — completely free, with no clutter and no broken links. Just clean stories, delivered the way reading should be.</p>\r\n<h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">How It All Started</h3>\r\n<p class=\"font-claude-response-body break-words whitespace-normal\">Finding good Urdu novels online used to mean dealing with pop-up ads, dead links, and badly formatted text. We got tired of it — so we built a library that actually respects the reader. One place, properly organized, that just works.</p>\r\n<p class=\"font-claude-response-body break-words whitespace-normal\">Today, Kitab Nagri hosts <strong>4,000+ Urdu novels</strong>, with new titles added every week across genres like romance, mystery, spiritual fiction, and family drama.</p>\r\n<h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">Why Readers Keep Coming Back</h3>\r\n<ul class=\"[li_&amp;]:mb-0 [li_&amp;]:mt-1 [li_&amp;]:gap-1 [&amp;:not(:last-child)_ul]:pb-1 [&amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3\">\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Clean Reading Interface</strong> — Proper right-to-left Urdu formatting, no messy scrolling or ads interrupting your story.</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Instant Free Downloads</strong> — No sign-up, no waiting period, no hidden charges.</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Weekly Updates</strong> — Fresh novels and episodes added regularly, sorted by genre and writer.</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Manually Reviewed Content</strong> — Every novel is checked by our team before it's published, so you always get proper formatting and complete episodes.</li>\r\n</ul>\r\n<h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">Some Well-Known Urdu Novels on Our Platform</h3>\r\n<p class=\"font-claude-response-body break-words whitespace-normal\">Over the years, our library has grown to include some of the most-loved titles in Urdu fiction, including:</p>\r\n<ul class=\"[li_&amp;]:mb-0 [li_&amp;]:mt-1 [li_&amp;]:gap-1 [&amp;:not(:last-child)_ul]:pb-1 [&amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3\">\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Peer-e-Kamil</strong> — Umera Ahmed's spiritual classic on faith and self-discovery</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Namal</strong> — Nimra Ahmed's gripping tale of ambition and destiny</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Jannat Kay Pattay</strong> — Nimra Ahmed's emotional story of love and sacrifice</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Aab-e-Hayat</strong> — Umera Ahmed's reflective novel on life and choices</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Mushaf</strong> — A widely-read spiritual and romantic novel</li>\r\n</ul>\r\n<p class=\"font-claude-response-body break-words whitespace-normal\">These titles, along with hundreds of others, are available to read online or download as PDFs — free of cost.</p>\r\n<h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">Popular Writers on Kitab Nagri</h3>\r\n<ul class=\"[li_&amp;]:mb-0 [li_&amp;]:mt-1 [li_&amp;]:gap-1 [&amp;:not(:last-child)_ul]:pb-1 [&amp;:not(:last-child)_ol]:pb-1 list-disc flex flex-col gap-1 pl-8 mb-3\">\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Umera Ahmed</strong> — known for emotional, real-life storytelling</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Nimra Ahmed</strong> — spiritual, mysterious, and romantic narratives</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Areej Shah</strong> — deep character-driven, emotional plots</li>\r\n<li class=\"font-claude-response-body whitespace-normal break-words pl-2\"><strong>Mehwish Ali</strong> — modern, relatable romance</li>\r\n</ul>\r\n<h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">Trusted by Readers Across the World</h3>\r\n<p class=\"font-claude-response-body break-words whitespace-normal\">From Pakistan to India, UK, and beyond, Kitab Nagri has become a go-to destination for Urdu novel lovers who want fast, free, and reliable access to good stories — without the usual hassle of ad-heavy sites.</p>\r\n<h3 class=\"text-text-100 mt-3 -mb-1 text-[1.125rem] font-bold\">One Official Website</h3>\r\n<p class=\"font-claude-response-body break-words whitespace-normal\">Please note: <strong><a class=\"underline underline underline-offset-2 decoration-1 decoration-current/40 hover:decoration-current focus:decoration-current\" href=\"http://kitabnagri.com.pk/\">kitabnagri.com.pk</a></strong> is our one and only official website. We do not operate under any other domain name, so always make sure you're on the correct site before reading or downloading.</p>\r\n<p class=\"font-claude-response-body break-words whitespace-normal\"><strong>Kitab Nagri — Read More, Own More.</strong></p>",
      "homepage_content_title": "",
      "homepage_description": "Discover Urdu novels across Romantic, Rude Hero, Forced Marriage, Revenge & Islamic genres. 100% free reading and downloads on Kitab Nagri",
      "homepage_famous_ids": [],
      "homepage_famous_title": "",
      "homepage_featured_image": "",
